# UIT Waifu environment variables.
# Copy to .env.local and fill in values. Never commit .env.local.

# App
NEXT_PUBLIC_APP_URL=https://accel.io.vn/waifu
# Base path the app is served under. The production target is accel.io.vn/waifu,
# so set this to /waifu for production builds. Leave empty for local root-path dev.
NEXT_PUBLIC_BASE_PATH=/waifu

# Supabase (NEXT_PUBLIC_* are exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Auth
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://accel.io.vn/waifu

# AI provider (set the one you use)
AI_PROVIDER=anthropic
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Chat Pages Function (Cloudflare). Set these in the Pages dashboard, not the browser bundle.
#   AI_PROVIDER         - openrouter or anthropic
#   OPENROUTER_API_KEY  - required when AI_PROVIDER=openrouter
#   OPENROUTER_MODEL    - optional, overrides the default model
#   ANTHROPIC_API_KEY   - required when AI_PROVIDER=anthropic
#   ANTHROPIC_MODEL     - optional, overrides the default Claude model
#   APP_URL             - optional, sent as HTTP-Referer to OpenRouter
OPENROUTER_MODEL=google/gemini-2.0-flash-001
ANTHROPIC_MODEL=claude-haiku-4-5
APP_URL=https://accel.io.vn/waifu

# Frontend override for the chat endpoint. Leave unset to use /api/chat on the
# Pages domain; set only if the Function is mounted under a different path.
NEXT_PUBLIC_CHAT_ENDPOINT=
