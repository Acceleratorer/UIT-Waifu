# UIT Waifu static export served at /waifu on Apache (DirectAdmin)
Options -Indexes -MultiViews
RewriteEngine On
RewriteBase /waifu/

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
  Header always set Strict-Transport-Security "max-age=15552000"
</IfModule>

# Serve existing files/directories as-is
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# DirectAdmin PHP adapters for API endpoints.
RewriteRule ^api/health$ api/health.php [L]
RewriteRule ^api/chat$ api/chat.php [L]

# Redirect exported pages with trailing slashes to their clean URL.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ $1 [R=301,L]

# Map extensionless clean URLs to their .html file (e.g. /waifu/chat -> chat.html)
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# Fallback for unknown routes
ErrorDocument 404 /waifu/404.html
